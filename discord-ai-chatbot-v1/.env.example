# Discord Developer Portal -> Bot -> Reset Token / Copy Token
DISCORD_TOKEN=replace_me

# Google AI Studio -> API keys
GEMINI_API_KEY=replace_me
# Change this if the model is unavailable to your API key/account.
GEMINI_MODEL=gemini-3.8-flash

# Supabase Project Settings -> API (Project URL + secret/service_role key)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=replace_with_server_secret_key

# Runtime limits
MAX_HISTORY=12
MAX_MEMORIES=12
MAX_OUTPUT_TOKENS=700
MEMORY_EXTRACT_EVERY=5
PER_USER_COOLDOWN=3
REQUEST_TIMEOUT=45
MAX_INPUT_CHARS=4000
LOG_LEVEL=INFO
